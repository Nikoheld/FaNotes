{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FaNotes Preview",
  "mainBinaryName": "fanotes-preview",
  "version": "2026.11.3-beta.1",
  "identifier": "ch.fasrv.fanotes.preview",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FaNotes",
        "width": 1480,
        "height": 940,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#f7f6f3"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "FaNotes",
    "category": "Education",
    "shortDescription": "FaNotes Preview (Tauri)",
    "longDescription": "Preview build of the FaNotes desktop app on Tauri. It installs next to FaNotes and keeps its own profile.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
