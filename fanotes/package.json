    "lucide-react": "^0.525.0",
    "nerdamer": "^1.1.13",
    "nspell": "^2.1.5",
    "onnxruntime-node": "1.21.0",
    "onnxruntime-web": "1.22.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "subtlex-word-frequencies": "^2.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^8.0.4"
