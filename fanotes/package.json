    "check:stay-put": "node scripts/check-stay-put.mjs",
    "check:bug-report": "node scripts/check-bug-report-window.mjs && node scripts/check-bug-report-submit.mjs && node scripts/check-paint-jump.mjs && node scripts/check-ghost-report.mjs && node scripts/check-scroll-text.mjs && node scripts/check-stay-put.mjs && node scripts/check-bug-pen-layer.mjs && node scripts/check-ink-notice-dismiss.mjs",
