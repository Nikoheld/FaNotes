  "build": {
    "appId": "ch.fanotes.app",
    "productName": "FaNotes",
    "artifactName": "FaNotes-${version}-x86_64.${ext}",
    "asar": true,
    "asarUnpack": [
      "dist/ocr/pylaia-iam.onnx"
    ],
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/ocr/fanotes-trocr-web/**/*",
      "!dist/ocr/pylaia-iam-q8.onnx",
      "electron/**/*",
      "resources/i18n/**/*",
      "resources/onenote/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education;Office",
      "icon": "build/icon.png",
      "executableName": "fanotes",
      "syncDesktopName": true,
      "synopsis": "Markdown-Notizen mit Handschrift f\u00fcr jeden Lebensbereich",
      "description": "Lokale Markdown-Wissensbasis mit Tablet-Zeichnungen und lernender Handschrifterkennung",
      "extraResources": [
        {
          "from": "native-math/linux-x64",
          "to": "native-math",
          "filter": [
            "crispembed",
            "crispembed-avx2",
            "runtime-manifest.json"
          ]
        },
        {
          "from": "node_modules/onnxruntime-node",
          "to": "native-ocr/node_modules/onnxruntime-node",
          "filter": [
            "package.json",
            "dist/*.js",
            "bin/napi-v3/linux/x64/onnxruntime_binding.node",
            "bin/napi-v3/linux/x64/libonnxruntime.so.1"
          ]
        },
        {
          "from": "node_modules/onnxruntime-node/node_modules/onnxruntime-common",
          "to": "native-ocr/node_modules/onnxruntime-common",
          "filter": [
            "package.json",
            "dist/cjs/**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "FaNotes",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "native-math/win32-x64",
          "to": "native-math",
          "filter": [
            "crispembed.exe",
            "crispembed-avx2.exe",
            "runtime-manifest.json"
          ]
        },
        {
          "from": "node_modules/onnxruntime-node",
          "to": "native-ocr/node_modules/onnxruntime-node",
          "filter": [
            "package.json",
            "dist/*.js",
            "bin/napi-v3/win32/x64/onnxruntime_binding.node",
            "bin/napi-v3/win32/x64/onnxruntime.dll"
          ]
        },
        {
          "from": "node_modules/onnxruntime-node/node_modules/onnxruntime-common",
          "to": "native-ocr/node_modules/onnxruntime-common",
          "filter": [
            "package.json",
            "dist/cjs/**/*"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "FaNotes-Setup-${version}-x64.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FaNotes",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "de_DE",
        "en_US"
      ]
    },
    "portable": {
      "artifactName": "FaNotes-Portable-${version}-x64.${ext}",
      "requestExecutionLevel": "user"
    },
    "appImage": {
      "executableArgs": [
        "--ozone-platform=x11",
        "--ozone-platform-hint=x11"
      ]
    }
  }
}
