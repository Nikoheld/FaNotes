    "check:onenote": "node scripts/check-onenote-import.cjs",
    "build:web": "npm run build:glyphenwerk && npm run build:spelling && npm run build:proper-names && npm run stage:trocr-runtime && tsc -b && vite build && node scripts/build-web-pwa.mjs",
    "build": "npm run build:web",
    "start": "electron .",
    "dist:linux": "npm run build:web && npm run stage:enhanced-math-runtime && electron-builder --linux AppImage --x64 --publish never && npm run check:packaged-i18n -- release/linux-unpacked/resources/app.asar && npm run dist:harden-appimage && npm run dist:portable",
    "dist:windows": "npm run build:web && cross-env FANOTES_NATIVE_TARGET_PLATFORM=win32 node scripts/stage-enhanced-math-runtime.cjs && electron-builder --win --x64 --publish never && npm run check:packaged-i18n -- release/win-unpacked/resources/app.asar",
    "dist:harden-appimage": "node scripts/harden-appimage.cjs release/FaNotes-2026.9.13-x86_64.AppImage",
    "dist:portable": "tar -C release --sort=name --owner=0 --group=0 --numeric-owner --mtime='@0' --mode='u+rwX,go+rX,go-w' --transform='s#^linux-unpacked#FaNotes-2026.9.13-x86_64#' -czf release/FaNotes-2026.9.13-x86_64.tar.gz linux-unpacked",
    "dist:dir": "npm run build:web && npm run stage:enhanced-math-runtime && electron-builder --linux dir --x64",
    "check:qwen-vision": "node scripts/check-qwen-vision.cjs",
    "check:paper-zoom": "node scripts/check-paper-zoom.mjs",
    "check:note-canvas": "node scripts/check-note-canvas.mjs",
    "check:paper-grow": "node scripts/check-paper-grow.mjs",
    "check:infinite-canvas-grow": "node scripts/check-infinite-canvas-grow.mjs",
