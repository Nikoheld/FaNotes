    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "7zip-bin": "5.2.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
