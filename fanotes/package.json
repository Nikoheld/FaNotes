    "check:send-data-policy": "node scripts/check-send-data-policy.mjs",
    "check:send-data-payload": "node scripts/check-send-data-payload.mjs",
    "check:send-data-battery": "node scripts/check-send-data-battery.mjs",
    "check:send-data-ui": "node scripts/check-send-data-ui.mjs",
    "check:send-data-server": "node scripts/check-send-data-server.mjs",
    "check:paper-ruling-fill": "node scripts/check-paper-ruling-fill.mjs",
    "check:paper-ruling-grid": "node scripts/check-paper-ruling-grid.mjs",
    "check:paper-ruling-ui": "node scripts/check-paper-ruling-ui.mjs",
    "check:bug-grow-down": "node scripts/check-bug-grow-down.mjs",
    "check:paper-lock": "node scripts/check-paper-lock.mjs",
    "check:ghost-ink": "node scripts/check-ghost-ink.mjs",
    "check:bug-pen-line-up": "node scripts/check-bug-pen-line-up.mjs",
    "check:bug-pen-line-up-stay": "node scripts/check-bug-pen-line-up-stay.mjs",
    "check:bug-pdf-pen": "node scripts/check-bug-pdf-pen.mjs",
    "check:bug-pen-layer": "node scripts/check-bug-pen-layer.mjs",
    "check:latest-bug": "node scripts/check-latest-bug.mjs",
    "check:ink-notice-dismiss": "node scripts/check-ink-notice-dismiss.mjs",
    "check:bug-text-shift": "node scripts/check-bug-text-shift.mjs",
    "check:pen-text-stay": "node scripts/check-pen-text-stay.mjs",
    "check:corner-stay": "node scripts/check-corner-stay.mjs",
    "check:long-down-stay": "node scripts/check-long-down-stay.mjs",
    "check:bug-ink-up": "node scripts/check-bug-ink-up.mjs",
    "check:bug-ink-up-stay": "node scripts/check-bug-ink-up-stay.mjs",
