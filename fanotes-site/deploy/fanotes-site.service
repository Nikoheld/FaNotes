[Unit]
Description=FaNotes public download website
After=network-online.target remote-fs.target clamav-daemon.service
Wants=network-online.target clamav-daemon.service
# The NAS is automounted and may become ready after the network-online target.
# A hard mount dependency leaves the public site permanently stopped when that
# first boot-time attempt races the NAS. Request and order the mount without
# making a transient NAS failure fatal to the website process.
WantsMountsFor=/mnt/truenas/Fabio/FaNotes-Arch-x86_64

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/fanotes-site
Environment=NODE_ENV=production
Environment=FANOTES_HOST=127.0.0.1
Environment=FANOTES_PORT=18185
Environment=FANOTES_RELEASE_DIR=/mnt/truenas/Fabio/FaNotes-Arch-x86_64
Environment=FANOTES_BACKUP_DIR=/var/lib/fanotes-backups
Environment=FANOTES_ANALYTICS_DIR=/var/lib/fanotes-analytics
Environment=FANOTES_HOMEWORK_DIR=/var/lib/fanotes-homework
Environment=FANOTES_BUG_REPORT_DIR=/var/lib/fanotes-bug-reports
Environment=FANOTES_SEND_DATA_DIR=/var/lib/fanotes-send-data
Environment=FANOTES_SYNC_DIR=/var/lib/fanotes-sync
Environment=FANOTES_MCP_DIR=/var/lib/fanotes-mcp
Environment=FANOTES_SHARE_DIR=/var/lib/fanotes-shares
Environment=FANOTES_PROFILE_DIR=/var/lib/fanotes-profiles
Environment=FANOTES_SCHULNETZ_DIR=/var/lib/fanotes-schulnetz
# School days 06:00–22:00 Zurich (2–5 min allowed, ±20 % jitter); nights, weekends and holidays are slower (pollDelayMs).
Environment=FANOTES_SCHULNETZ_POLL_MS=150000
# Encrypted X-FaNotes-Meta may be 8 KiB of bytes, about 11 KiB of Base64,
# plus the session headers. The Node default of 16 KiB can reject that.
Environment=NODE_OPTIONS=--max-http-header-size=65536
# Credentials replace the broad /etc/fanotes read. Omit a line at deploy when that file is absent.
LoadCredential=schulnetz-token:/etc/fanotes/schulnetz-token.key
LoadCredential=fcm-service-account:/etc/fanotes/fcm-service-account.json
LoadCredential=update-signing-key:/etc/fanotes/update-signing-private.pem
LoadCredential=release-checksum-signature:/etc/fanotes/SHA256SUMS.sig
LoadCredential=backup-enrollment-token:/etc/fanotes/backup-enrollment-token
# SHA-256 (hex) of the operator's timetable-upload token; the route answers 503 without it.
LoadCredential=kanti-admin-token:/etc/fanotes/kanti-admin-token.sha256
ExecStart=/usr/bin/node /opt/fanotes-site/server.mjs
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=64
MemoryHigh=1200M
MemoryMax=1600M
SystemCallArchitectures=native
ReadOnlyPaths=/mnt/truenas/Fabio/FaNotes-Arch-x86_64
InaccessiblePaths=/etc/fanotes
ReadWritePaths=/var/lib/fanotes-backups
ReadWritePaths=/var/lib/fanotes-analytics
ReadWritePaths=/var/lib/fanotes-homework
ReadWritePaths=/var/lib/fanotes-bug-reports
ReadWritePaths=/var/lib/fanotes-send-data
ReadWritePaths=/var/lib/fanotes-sync
ReadWritePaths=/var/lib/fanotes-mcp
ReadWritePaths=/var/lib/fanotes-shares
ReadWritePaths=/var/lib/fanotes-profiles
ReadWritePaths=/var/lib/fanotes-schulnetz

[Install]
WantedBy=multi-user.target
