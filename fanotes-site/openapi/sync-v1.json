                "schema": {
                  "$ref": "#/components/schemas/Changes"
                }
              }
            }
          },
          "default": {
            "description": "An error object. The text is a fixed sentence, with no note body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": [],
            "accountHeader": []
          }
        ]
      }
    },
    "/devices/{deviceId}": {
