{
  "openapi": "3.0.3",
  "info": {
    "title": "FaNotes Sync API",
    "version": "1",
    "description": "End-to-end encrypted file sync. Bodies and X-FaNotes-Meta are ciphertext. The server stores a scrypt hash of the auth key and never sees a password, a note, a file name, or the vault key. File ids are 64 hex characters. A write that would replace a newer note with an empty or collapsed body is refused."
  },
  "servers": [
    {
      "url": "https://fanotes.fasrv.ch/api/v1/sync"
    }
  ],
  "tags": [
    {
      "name": "sync"
    }
  ],
  "paths": {
    "/account": {
      "get": {
        "operationId": "getAccount",
        "summary": "Return the account, its devices, and its usage.",
        "parameters": [
          {
            "$ref": "#/components/parameters/requestId"
          }
        ],
        "responses": {
          "200": {
            "description": "The account summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "default": {
            "description": "An error object. The text is a fixed sentence, with no note body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": [],
            "accountHeader": []
          }
        ]
      },
      "delete": {
        "operationId": "deleteAccount",
        "summary": "Delete the account after the auth key is checked.",
        "parameters": [
          {
            "$ref": "#/components/parameters/requestId"
          }
        ],
        "responses": {
          "204": {
            "description": "No body."
          },
          "default": {
            "description": "An error object. The text is a fixed sentence, with no note body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": [],
            "accountHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthKeyBody"
              }
            }
          }
        }
      }
    },
    "/changes": {
      "get": {
        "operationId": "getChanges",
        "summary": "List file-table entries newer than a revision.",
        "parameters": [
          {
            "$ref": "#/components/parameters/requestId"
          },
          {
            "$ref": "#/components/parameters/since"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of file-table entries.",
