                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "accountHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-FaNotes-Account"
      }
    },
    "parameters": {
      "fileId": {
        "name": "fileId",
        "in": "path",
        "required": true,
        "description": "HMAC of the file path, as 64 hex characters.",
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "uploadId": {
        "name": "uploadId",
        "in": "path",
        "required": true,
        "description": "Id of one partial upload.",
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "deviceId": {
        "name": "deviceId",
        "in": "path",
        "required": true,
        "description": "Id of one device.",
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        }
      },
      "requestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "description": "Optional client id, 8 to 64 characters of letters, digits, dot, underscore, or hyphen. A value that repeats the token or metadata is ignored.",
        "schema": {
          "type": "string"
        }
      },
      "since": {
        "name": "since",
        "in": "query",
        "required": false,
        "description": "Return entries with a higher revision.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "ifMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "The file revision this write is based on.",
        "schema": {
          "type": "string"
        }
      },
      "meta": {
        "name": "X-FaNotes-Meta",
        "in": "header",
        "required": true,
        "description": "Encrypted file metadata, base64. The server does not read it.",
        "schema": {
          "type": "string"
        }
      },
      "sha256": {
        "name": "X-FaNotes-Sha256",
        "in": "header",
        "required": true,
        "description": "Hex SHA-256 of the ciphertext.",
        "schema": {
          "type": "string"
        }
      },
      "blank": {
        "name": "X-FaNotes-Blank",
        "in": "header",
        "required": false,
        "description": "1 when the client says the note is empty, 0 when it still has content.",
        "schema": {
          "type": "string"
        }
      },
      "clear": {
        "name": "X-FaNotes-Clear",
        "in": "header",
        "required": false,
        "description": "1 is the only header that may store an empty or collapsed body over a note.",
        "schema": {
          "type": "string"
        }
      },
      "confirmDelete": {
        "name": "X-FaNotes-Delete",
        "in": "header",
        "required": true,
        "description": "Must be 1. A delete without it does not tombstone the file.",
        "schema": {
          "type": "string"
        }
      },
      "uploadOffset": {
        "name": "Upload-Offset",
        "in": "header",
        "required": true,
        "description": "Must equal the number of bytes already stored for this upload.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "AuthKeyBody": {
        "type": "object",
        "required": [
          "authKey"
        ],
        "properties": {
          "authKey": {
            "type": "string",
            "description": "Base64 auth key derived by the client. Not a password."
          }
        }
      },
      "Kdf": {
        "type": "object",
        "required": [
          "algorithm",
          "iterations",
          "salt"
        ],
        "properties": {
          "algorithm": {
            "type": "string",
            "enum": [
              "pbkdf2-sha256"
            ]
          },
          "iterations": {
            "type": "integer",
            "minimum": 300000
          },
          "salt": {
            "type": "string"
          }
        }
      },
      "KeyWrap": {
        "type": "object",
        "required": [
          "iv",
          "data"
        ],
        "properties": {
          "iv": {
            "type": "string"
          },
          "data": {
            "type": "string"
          }
        }
      },
      "PreloginRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Prelogin": {
        "type": "object",
        "properties": {
          "kdf": {
            "$ref": "#/components/schemas/Kdf"
          }
        }
      },
      "SessionRequest": {
        "type": "object",
        "required": [
          "email",
          "authKey"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "authKey": {
            "type": "string"
          },
          "device": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              }
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "authKey",
          "kdf",
          "vaultKeyWrap",
          "device"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "authKey": {
            "type": "string"
          },
          "kdf": {
            "$ref": "#/components/schemas/Kdf"
          },
          "vaultKeyWrap": {
            "$ref": "#/components/schemas/KeyWrap"
          },
          "device": {
            "type": "object",
            "required": [
              "name",
              "platform"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              }
            }
          }
        }
      },
      "PasswordRequest": {
        "type": "object",
        "required": [
          "authKey",
          "newAuthKey",
          "kdf",
          "vaultKeyWrap"
        ],
        "properties": {
          "authKey": {
            "type": "string"
          },
          "newAuthKey": {
            "type": "string"
          },
          "kdf": {
            "$ref": "#/components/schemas/Kdf"
          },
          "vaultKeyWrap": {
            "$ref": "#/components/schemas/KeyWrap"
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "kdf": {
            "$ref": "#/components/schemas/Kdf"
          },
          "vaultKeyWrap": {
            "$ref": "#/components/schemas/KeyWrap"
          }
        }
      },
      "WriteResult": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer"
          },
          "tableRevision": {
            "type": "integer"
          },
          "uploadId": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "usage": {
            "type": "object",
            "additionalProperties": true
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "FileEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "deleted": {
            "type": "boolean"
          },
          "size": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "nullable": true
          },
          "meta": {
            "type": "string",
            "nullable": true,
            "description": "Encrypted metadata."
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          },
          "deviceId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Changes": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileEntry"
            }
          },
          "more": {
            "type": "boolean"
          },
          "nextSince": {
            "type": "integer"
          }
        }
      },
      "Conflict": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "stale",
              "guard",
              "offset",
              "incomplete"
            ]
          },
          "entry": {
            "$ref": "#/components/schemas/FileEntry"
          },
          "offset": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "UploadCreate": {
        "type": "object",
        "required": [
          "size"
        ],
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 28
          }
        }
      },
      "Upload": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string"
          },
          "fileId": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "RestoreRequest": {
        "type": "object",
        "required": [
          "revision"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "RevisionList": {
        "type": "object",
        "properties": {
          "revisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "integer"
                },
                "size": {
                  "type": "integer"
                },
                "collapse": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "IntegrityReport": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "filesChecked": {
            "type": "integer"
          },
          "blobsMissing": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "hashMismatch": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "blobsOrphan": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "revisionsOrphan": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "incoming": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "uploads": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "quarantine": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
