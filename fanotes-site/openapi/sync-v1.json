          }
        ]
      }
    },
    "/files/{fileId}": {
      "get": {
        "operationId": "getFilesFileId",
        "summary": "Download one ciphertext blob.",
        "parameters": [
          {
            "$ref": "#/components/parameters/fileId"
          },
          {
            "$ref": "#/components/parameters/requestId"
          }
        ],
        "responses": {
          "200": {
            "description": "The ciphertext.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "An error object. The text is a fixed sentence, with no note body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": [],
            "accountHeader": []
          }
        ]
      },
      "head": {
        "operationId": "headFilesFileId",
        "summary": "Return the blob headers without the body.",
        "parameters": [
          {
            "$ref": "#/components/parameters/fileId"
          },
          {
            "$ref": "#/components/parameters/requestId"
          }
        ],
        "responses": {
          "200": {
            "description": "No body."
          },
          "default": {
            "description": "An error object. The text is a fixed sentence, with no note body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": [],
            "accountHeader": []
          }
        ]
      },
      "put": {
        "operationId": "putFilesFileId",
        "summary": "Store one ciphertext blob when the base revision and the merge guard accept it.",
        "parameters": [
          {
            "$ref": "#/components/parameters/fileId"
          },
          {
            "$ref": "#/components/parameters/requestId"
          },
          {
            "$ref": "#/components/parameters/ifMatch"
          },
          {
            "$ref": "#/components/parameters/meta"
          },
          {
            "$ref": "#/components/parameters/sha256"
          },
          {
            "$ref": "#/components/parameters/blank"
          },
          {
            "$ref": "#/components/parameters/clear"
          }
        ],
        "responses": {
          "200": {
            "description": "The new file revision. The body is stored only after the guard accepts it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteResult"
                }
              }
            }
          },
          "409": {
            "description": "stale: the base revision is not current. guard: the body would replace a note with an empty or collapsed one. The live blob is unchanged.",
            "headers": {
              "X-FaNotes-Rejected": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "guard"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conflict"
                }
              }
            }
          },
          "default": {
            "description": "An error object. The text is a fixed sentence, with no note body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": [],
            "accountHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary",
                "description": "Ciphertext. The server does not interpret it."
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteFilesFileId",
        "summary": "Tombstone one file. The previous blob is archived first.",
        "parameters": [
          {
            "$ref": "#/components/parameters/fileId"
          },
          {
            "$ref": "#/components/parameters/requestId"
          },
          {
            "$ref": "#/components/parameters/ifMatch"
          },
          {
            "$ref": "#/components/parameters/confirmDelete"
          }
        ],
        "responses": {
          "204": {
            "description": "No body."
          },
          "409": {
            "description": "stale: the base revision is not current. guard: the body would replace a note with an empty or collapsed one. The live blob is unchanged.",
            "headers": {
              "X-FaNotes-Rejected": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "guard"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conflict"
                }
              }
            }
          },
          "default": {
            "description": "An error object. The text is a fixed sentence, with no note body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": [],
            "accountHeader": []
          }
        ]
      }
    },
