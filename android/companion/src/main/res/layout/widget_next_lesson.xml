<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@+id/widget_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_kicker"
        android:textColor="@color/widget_accent"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="@string/app_name"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text=""
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text=""
        android:maxLines="4"
        android:ellipsize="end"
        android:visibility="gone"
        android:textColor="@color/widget_muted"
        android:textSize="14sp" />
</LinearLayout>
