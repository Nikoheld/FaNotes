<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview: the large step with an invented route. Static, no list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium" android:maxLines="1"
        android:text="@string/commute_widget_kicker" android:textColor="@color/widget_accent" android:textSize="12sp" />
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium" android:maxLines="1" android:paddingTop="2dp"
        android:text="@string/widget_preview_route" android:textColor="@color/widget_text" android:textSize="17sp" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="48dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:text="@string/widget_preview_c1" android:textColor="@color/widget_text" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:text="@string/widget_preview_c2" android:textColor="@color/widget_warning" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:background="@drawable/widget_chip" android:backgroundTint="#003399"
            android:fontFamily="sans-serif-medium" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:paddingTop="1dp" android:paddingBottom="1dp" android:text="@string/widget_preview_c3" android:textColor="#FFFFFF" android:textSize="12sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:text="@string/widget_preview_platform" android:textColor="@color/widget_muted" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:text="@string/widget_preview_c4" android:textColor="@color/widget_muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="48dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:text="@string/widget_preview_c5" android:textColor="@color/widget_text" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:text="@string/commute_on_time_short" android:textColor="@color/widget_success" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:background="@drawable/widget_chip" android:backgroundTint="#E2001A"
            android:fontFamily="sans-serif-medium" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:paddingTop="1dp" android:paddingBottom="1dp" android:text="@string/widget_preview_c6" android:textColor="#FFFFFF" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
