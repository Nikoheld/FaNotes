    <color name="widget_muted">@android:color/system_neutral2_700</color>
    <color name="widget_accent">@android:color/system_accent1_700</color>
    <color name="widget_outline">@android:color/system_neutral2_200</color>
    <color name="widget_container">@android:color/system_neutral2_100</color>
    <color name="widget_accent_container">@android:color/system_accent1_100</color>
    <color name="widget_on_accent_container">@android:color/system_accent1_900</color>
